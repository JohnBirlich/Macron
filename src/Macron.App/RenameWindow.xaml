<Window x:Class="Macron.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименовать"
        Height="150" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Новое имя макроса:" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox" Grid.Row="0" Margin="0,22,0,0"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="ОК" MinWidth="70" Margin="0,0,8,0" Click="OnOk"/>
            <Button Content="Отмена" MinWidth="70" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
