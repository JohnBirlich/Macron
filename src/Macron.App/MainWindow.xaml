<Window x:Class="Macron.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/schemas.microsoft.com-compatibility/2006"
        xmlns:core="clr-namespace:Macron.Core;assembly=Macron.Core"
        mc:Ignorable="d"
        Title="Macron — запись, воспроизведение и сохранение макросов"
        Height="560" Width="840"
        MinHeight="420" MinWidth="640"
        Closing="OnClosing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Верхняя панель: Record · Stop · Play · Save · Open · Settings -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="⏺ Record" Style="{StaticResource DangerButton}" Command="{Binding RecordCommand}"/>
            <Button Content="■ Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}"/>
            <Button Content="▶ Play" Style="{StaticResource SuccessButton}" Command="{Binding PlayCommand}"/>
            <Button Content="💾 Save" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}"/>
            <Button Content="📂 Open" Style="{StaticResource ToolbarButton}" Command="{Binding OpenCommand}"/>
            <Button Content="⚙ Settings" Style="{StaticResource ToolbarButton}" Command="{Binding SettingsCommand}"/>
        </StackPanel>

        <!-- Список макросов -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Макросы" Margin="0,0,5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="140"/>
                            <GridViewColumn Header="Длительность" DisplayMemberBinding="{Binding DurationText}" Width="90"/>
                            <GridViewColumn Header="Событий" DisplayMemberBinding="{Binding EventCount}" Width="70"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" MinWidth="75" Margin="0,0,6,0"/>
                    <Button Content="Переименовать" Command="{Binding RenameCommand}" MinWidth="95"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Настройки воспроизведения -->
        <GroupBox Grid.Row="1" Grid.Column="1" Header="Воспроизведение" Margin="5,0,0,0">
            <StackPanel Margin="10">
                <TextBlock Text="Скорость" Margin="0,0,4,0"/>
                <Slider Minimum="0.1" Maximum="10" Value="{Binding Speed}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}×}" Margin="0,0,0,10"/>

                <TextBlock Text="Повтор" Margin="0,0,4,0"/>
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RepeatMode}" Margin="0,0,0,6">
                    <ComboBoxItem Tag="{x:Static core:RepeatMode.Once}" Content="Один раз"/>
                    <ComboBoxItem Tag="{x:Static core:RepeatMode.Count}" Content="N раз"/>
                    <ComboBoxItem Tag="{x:Static core:RepeatMode.Infinite}" Content="Бесконечно"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="N:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=LostFocus}" Width="55"/>
                </StackPanel>

                <TextBlock Text="Пауза перед стартом (сек.)" Margin="0,0,4,0"/>
                <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus}" Width="55" Margin="0,0,0,10"/>

                <CheckBox Content="Записывать движения мыши" IsChecked="{Binding RecordMouseMoves}" Margin="0,0,0,10"/>
            </StackPanel>
        </GroupBox>

        <!-- Статус-бар -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusText}"/>
        </StatusBar>

        <!-- Счётчики -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
            <Run Text="Событий: "/>
            <Run Text="{Binding CurrentEventCount}"/>
            <Run Text="   "/>
            <Run Text="Длительность: "/>
            <Run Text="{Binding CurrentDuration, StringFormat={}{0:mm\:ss}}"/>
        </TextBlock>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0"
                   Text="Горячие клавиши: F6 Record · F8 Play · F7 Stop · Panic — Ctrl+Alt+F12"
                   Foreground="#666666"/>
    </Grid>
</Window>
